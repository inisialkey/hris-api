# Local development. Names are the environments.md §6 registry; a variable added
# to the code is added to that table in the same session.
#
# Generate the Ed25519 pair with:
#   node scripts/generate-jwt-key.mjs

APP_ENV=local
APP_ROLE=both
PORT=3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# hris_app — never the owner, never BYPASSRLS. Connecting as `postgres` here
# makes every tenant-isolation defect invisible on a laptop (environments.md §4).
DATABASE_URL=postgres://hris_app:hris_app@localhost:5432/hris
# hris_migrator — the migrate Job only, never an application pod.
DATABASE_MIGRATOR_URL=postgres://hris_migrator:hris_migrator@localhost:5432/hris
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

JWT_ACTIVE_KID=local-1
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ADR-0016's KEK on a laptop: base64 of 32 bytes. `LocalKeyProvider` refuses to
# construct outside APP_ENV=local and test, so a staging pod carrying this by
# accident still cannot use it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KEK=

# ADR-0009's bucket. Locally this is fake-gcs-server, which needs no credentials
# and verifies no signature — a signed URL there is just a URL, which is enough
# to exercise the sign → PUT → confirm pipeline end to end.
GCS_BUCKET=hris-local
FIREBASE_PROJECT_ID=hris-local
STORAGE_EMULATOR_HOST=http://localhost:4443
