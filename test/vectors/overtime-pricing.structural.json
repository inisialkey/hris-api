      "source": "overtime.md §4.5 worked example 1 (shape) — first hour and the rest split at the absolute one-hour bound; payable clamps to the 155-minute actual",
      "input": { "dayClass": "work_day", "plannedMinutes": 180, "actualMinutes": 155, "acknowledged": true, "scheduledStandardMinutes": 420, "fallbackStandardDayMinutes": 420, "mealThresholdMinutes": 240, "compensation": "pay" },
      "expected": { "standardDayMinutes": 420, "payableMinutes": 155, "tiers": [ { "factor": "2.00", "minutes": 60 }, { "factor": "2.00", "minutes": 95 } ], "multiplierHours": "5.1667", "mealEntitled": false, "toilDays": null }
    },
